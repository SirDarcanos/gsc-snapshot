{
  "name": "gsc-snapshot",
  "version": "0.2.0",
  "description": "Create reproducible, read-only Google Search Console snapshots for humans and agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirDarcanos/gsc-snapshot.git"
  },
  "type": "module",
  "exports": {},
  "bin": {
    "gsc-snapshot": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "node scripts/check-format.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@googleapis/searchconsole": "^7.1.0",
    "google-auth-library": "^11.0.2"
  }
}
